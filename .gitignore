__pycache__/
*.pyc
daemon/recordings/
apk/local.properties
apk/.gradle/
apk/build/
apk/app/build/
.idea/
*.keystore
push.env

# built APK is committed as a release artifact at repo root; ignore build intermediates
apk/gradle/wrapper/dists/

# Local expo modules ARE tracked (app/modules/glasses is real source), but a
# native build drops gradle output inside them - first seen 2026-08-21, when
# assembleRelease left app/modules/glasses/android/build/ as ~700 untracked
# files. Ignore the output, keep the source.
app/modules/*/android/build/
daemon/tracks.json
daemon/settings.json
daemon/plane_links.json
daemon/plane_credentials.txt
daemon/events.jsonl
daemon/tracks.json
daemon/users.json
daemon/sessions.json
daemon/processes.json
daemon/copilot_sessions.json
# rendered speech clips (voice.py): regenerated on demand, content-addressed
daemon/voice_cache/
web/node_modules/
web/.next/
daemon/checkpoints/
daemon/swarmdeck.db
daemon/helmdeck.db
daemon/*.imported
daemon/**/*.imported
daemon/tracks.json.imported
.loop/
daemon/copilot_log.json
daemon/copilot_stats.json
daemon/driver_pids.json
daemon/recorder_pids.json
daemon/nightshift/state.json
daemon/restart_stdout.log
daemon/restart_stderr.log
daemon/daemon.out.log
app/dist-desktop/
web/devserver.log
app/web_dev.log
daemon/swarmdeck.db-wal
daemon/swarmdeck.db-shm
daemon/helmdeck.db-wal
daemon/helmdeck.db-shm
plane-selfhost/.env
plane-selfhost/*.env
backups/
docs

# local credentials - never commit
# App Store Connect API key. Apple serves the .p8 exactly ONCE - there is no
# re-download - and it can mint iOS signing certificates, so treat it like the
# Android keystore. deploy/ios_credentials.sh additionally REFUSES to run when
# the key lives anywhere under this repo; this line is only the second net.
*.p8
daemon/certs/
.env
*.env
!.env.example
google-services.json
fcm_service_account.json
daemon/models_cache.json
daemon/pm/
tests/banner_offline.png

# UI-judging screenshots (regenerate with tests/uifix_shoot.py)
tests/_shots/

# chat attachments the owner uploads (phone screenshots of his own board, etc).
# Runtime user data, exactly like daemon/recordings/ and daemon/checkpoints/ -
# electron-builder.yml already refuses to ship .attachments/** for the same
# reason. Ignoring it protects only the FUTURE: five of these were committed
# before this line existed and are still reachable in history, which is what
# deploy/publish_source.sh's privacy check is there to catch before a push
# makes them public.
.attachments/
daemon/.attachments/
daemon/.copilot_attachments/

# deploy artifacts (generated by deploy/ship.sh): native fingerprint state +
# the emulator smoke screenshot - machine-local, regenerated each ship
deploy/.native_fp
deploy/last_apk_smoke.png
# deploy/asc_guide.py's screenshot of App Store Connect: regenerated on every
# `shot`, and once logged in it shows the owner's Apple ID and app list.
shots/asc.png
# same reason: deploy/meta_wearables_guide.py's screenshot shows the owner's
# Meta org/project details once logged in.
shots/meta_wearables.png
daemon/daemon.pid
desktop/_probe_setup.js
desktop/python/
copilot_runs/
# harness/.versions: every /harness write archives the file it replaced so a bad
# edit is revertable. Machine-local undo history, not shipped policy - the
# CURRENT harness/agents/*.md and harness/settings/*.json are what's tracked.
harness/.versions/

# glasses/worker/public is GENERATED by deploy/push_glance.sh from the three
# real files in glasses/ (index.html, styles.css, app.js). Tracking it would
# mean two copies of the app that can silently disagree; the sync is a build
# step, exactly like glass-crud-harness's apps/ -> worker/public/.
glasses/worker/public/
glasses/worker/node_modules/
# stray stdout/stderr redirects from a backgrounded `wrangler dev` - local run
# artifacts, not source. Two of these leaked into a commit once; never again.
glasses/worker/dev.log
glasses/worker/dev.err
.wrangler/
# .dev.vars holds DAEMON_URL for `wrangler dev` - a route into the owner's
# machine. Same rule as push.env: never committed.
*.dev.vars
.dev.vars
daemon/policy_live.json
daemon/escalations.jsonl
