{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelmDeck",
  "version": "0.1.0",
  "identifier": "work.21stgen.helmdeck",
  "build": {
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMTU5ODAyNUFCRjdCMTAKUldRUWU3OWFBcGdWc3lGMGFheEg3N0lNK04xaXNHVENSYzYzeGpjN0JrU2Y3QVJIam1aMHFPTHEK",
      "endpoints": [
        "https://github.com/Tienduyvo/helmdeck-release/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
