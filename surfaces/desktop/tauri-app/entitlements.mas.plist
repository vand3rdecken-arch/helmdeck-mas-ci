<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Tauri window under the Mac App Store's MANDATORY App Sandbox. Same grants as the Electron MAS build
  (surfaces/desktop/build/entitlements.mas.plist) minus Chromium's JIT/memory pair: WKWebView runs its
  JavaScript in Apple's own WebContent process, which carries its own entitlements.

    network.client / network.server - the daemon on 127.0.0.1:8140, the UI server on :3300 and the setup
      control plane on :8141 are all loopback, but the sandbox needs both directions; the daemon also dials
      the relay over the internet.
    files.user-selected.read-write - folders the owner picks in the Open panel. Necessary, not sufficient:
      the sandbox scope of "an agent works in ANY repo" is the open debt mac-app-store-sandbox-scope,
      shared with the Electron build.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
