// HelmDeck Glance worker - hosts the Ray-Ban Display webapp and proxies the
// four /glance routes to the daemon. See src/index.js for the security model
// and surfaces/glasses/worker/README.md for the one-time setup.
//
// Deploy:  bash ops/deploy/push_glance.sh
// Secret:  npx wrangler secret put DAEMON_URL
//          (the HTTPS origin in front of :8140 - `bash ops/deploy/cloudflare_tunnel.sh`)
//
// `public/` is GENERATED by push_glance.sh from surfaces/glasses/*.{html,css,js} and is
// git-ignored. Editing it directly is pointless; the next deploy overwrites it.
{
  "name": "helmdeck-glance",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // Custom domain instead of the default *.workers.dev URL - short and
  // memorable for the one-time Add-a-Web-App registration on the glasses.
  // Cloudflare provisions the DNS record + TLS cert automatically since
  // helmdeck.de is already on this account's zone.
  "routes": [
    { "pattern": "glance.helmdeck.de", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker decides first, every request. Assets must NOT shadow the
    // allowlisted API paths, and the 404 for anything else has to be ours.
    "run_worker_first": true
  }
}
