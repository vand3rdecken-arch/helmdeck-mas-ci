+// ---- on-device drag (phone board) --------------------------------------------
+// The phone stacks lanes vertically in one ScrollView, so cross-lane dragging
+// can't rely on column hit-testing like the desktop kanban. Instead: a long
+// press lifts the card, a full-screen overlay with four big lane BANDS appears
+// (labelled from settings.policy.lane_labels), a ghost chip follows the finger,
+// and releasing over a band moves the card. Releasing without having dragged
+// falls back to the move sheet. NO reanimated worklets on this path: the
+// enabled React Compiler mangles useAnimatedStyle on device (see RunningPulse),
+// so the gesture runs .runOnJS(true) and the ghost is core-Animated.
+
+function DeviceDragCard({ k, dragging, onLift, onDragMove, onDrop, onDragEnd, children }: {
+  k: Track;
+  dragging: boolean;
+  onLift: (k: Track, x: number, y: number) => void;
+  onDragMove: (x: number, y: number) => void;
+  onDrop: (k: Track, y: number, moved: boolean) => void;
+  onDragEnd: () => void;
+  children: React.ReactNode;
+}) {
+  const moved = useRef(false);
+  const pan = Gesture.Pan()
+    .activateAfterLongPress(260)
+    .runOnJS(true)
+    .onStart((e) => { moved.current = false; onLift(k, e.absoluteX, e.absoluteY); })
+    .onUpdate((e) => {
+      if (!moved.current && Math.hypot(e.translationX, e.translationY) > 8) moved.current = true;
+      onDragMove(e.absoluteX, e.absoluteY);
+    })
+    .onEnd((e) => onDrop(k, e.absoluteY, moved.current))
+    .onFinalize(() => onDragEnd());
+  return (
+    <GestureDetector gesture={pan}>
+      <View style={{ opacity: dragging ? 0.35 : 1 }}>{children}</View>
+    </GestureDetector>
+  );
+}
