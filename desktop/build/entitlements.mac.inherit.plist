<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the HELPER binaries inside HelmDeck.app (Renderer, GPU,
  Plugin). They must carry the same JIT permissions plus the inherit flag,
  which makes each helper adopt its parent's sandbox/runtime decisions instead
  of asserting its own - the standard Electron arrangement, restated here
  because naming a custom entitlements file replaces the built-in default.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
