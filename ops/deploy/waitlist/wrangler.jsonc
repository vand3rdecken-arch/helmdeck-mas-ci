// HelmDeck public-launch waitlist worker (M4 prep).
// Deploy:  cd ops/deploy/waitlist && npx wrangler deploy
// Secret:  npx wrangler secret put EXPORT_TOKEN   (owner CSV export auth)
{
  "name": "helmdeck-waitlist",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public"
  },
  "kv_namespaces": [
    {
      "binding": "WAITLIST",
      "id": "762164d2bc4343b8b22f24755f017453"
    }
  ],
  "d1_databases": [
    {
      "binding": "SITE_STATS",
      "database_name": "helmdeck-site-stats",
      "database_id": "8151a80c-43cc-49cc-a914-9dd77f4391a9"
    }
  ]
}
