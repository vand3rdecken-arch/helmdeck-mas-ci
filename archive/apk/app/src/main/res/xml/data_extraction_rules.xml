<?xml version="1.0" encoding="utf-8"?>
<!--
  The pairing store is encrypted with an AndroidKeystore key that never leaves
  the device and is not part of any backup. Copying the ciphertext to a new
  install (cloud restore or device transfer) therefore yields data that can
  never be decrypted - it crashed the app with AEADBadTagException on launch.
  Excluding it means the user re-pairs after a restore, which is the correct
  and safe behaviour for a credential.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hub.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hub.xml" />
    </device-transfer>
</data-extraction-rules>
